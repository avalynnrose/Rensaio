{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Grpc": "Warning"
    }
  },
  "Rpc": {
    "Cef": {
      "Enabled": true
    },
    "Lru": {
      "MaxLoadedExtensions": 6,
      "IdleUnloadMinutes": 30,
      "SweepIntervalSeconds": 300
    }
  }
}
